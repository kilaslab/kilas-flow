{
  "name": "kilasflow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "postinstall": "node scripts/vendor-docs.mjs",
    "vendor-docs": "node scripts/vendor-docs.mjs",
    "dev": "node scripts/vendor-docs.mjs && vite dev",
    "build": "node scripts/vendor-docs.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "node scripts/generate-api-client.mjs",
    "generate:api:check": "node scripts/check-api-client.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.46.0",
    "@scalar/api-reference": "^1.69.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "orval": "^8.33.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/svelte-query": "^6.2.1",
    "@xyflow/svelte": "1.6.6",
    "bits-ui": "^2.19.2"
  }
}
