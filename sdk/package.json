{
  "name": "@kilasflow/sdk",
  "version": "0.1.0",
  "description": "Host integration SDK for KilasFlow: workflow management, embedded editor sessions, and execution events.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilaslab/kilas-flow.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/kilaslab/kilas-flow#readme",
  "bugs": "https://github.com/kilaslab/kilas-flow/issues",
  "keywords": ["kilasflow", "workflow", "automation", "embed", "host-sdk"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "generate:types:check": "node scripts/check-types.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release.mjs guard"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "orval": "^8.27.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
