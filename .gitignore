web/static/vendor/

# Embedded SPA build output.
# The placeholder files are committed so `go build` works on a fresh clone
# before the frontend has ever been built. See internal/web/embed.go.
internal/web/dist/*
!internal/web/dist/.gitkeep
!internal/web/dist/index.html

