# Build artifacts
bin/
.tmp/
*.exe

# Runtime data
data/
*.db
*.db-shm
*.db-wal

# Local configuration
config.yaml
.env
.env.*
!.env.example

# Frontend
node_modules/
web/build/
web/.svelte-kit/
web/.tmp/
.pnpm-store/

# Scalar docs bundle, copied from node_modules by web/scripts/vendor-docs.mjs
web/static/vendor/

# Embedded SPA build output. Everything under it belongs to the frontend build,
# and the only committed file is the .gitkeep that keeps the directory — and so
# the go:embed directive — present on a fresh clone. The placeholder page a
# clone without a build serves lives outside this directory, in
# internal/web/placeholder/index.html, so no build rewrites a tracked file.
# See internal/web/embed.go.
internal/web/dist/*
!internal/web/dist/.gitkeep

# Playwright MCP scratch output (snapshots, console logs, screenshots)
.playwright-mcp/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Devbox
.devbox/

# n8n UI screenshots kept locally as a design reference for the editor and node
# property panels. Not committed: they are third-party product UI, only useful
# while designing, and would bloat the repo.
design-refs/

# SDK build output and generated spec scratch
sdk/dist/
sdk/.tmp/
sdk/node_modules/

# Regression corpus: third-party n8n and WAHA workflow fixtures, fetched by
# scripts/corpus-sync.sh and never committed. n8n's fixtures are
# LicenseRef-n8n-sustainable-use and the WAHA templates repository carries no
# licence at all. .corpus-private/ is the overlay for the owner's own exported
# client workflows, which contain live phone numbers, hostnames and credential
# names. See .pine/memory/licensing.md.
.corpus/
.corpus-cache/
.corpus-private/

# Agent worktrees are checkouts of this repository, not content of it.
.claude/worktrees/
.gowa-ref/
/kilasflow
.svelte-kit/
