{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilasflow.dev/schemas/workflow-v1.schema.json",
  "title": "KilasFlow Workflow Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "nodes", "connections", "settings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "settings": { "type": "object" },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "description": "Optional, ordered labels that group workflows. A tag has no leading or trailing whitespace, no comma and no control character, and tags are unique ignoring case. The engine measures length in UTF-16 code units (the way n8n does), so a tag of astral characters such as emoji counts two per character; maxLength here counts code points, so it is a bound every valid tag meets.",
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "port"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "typeVersion", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "typeVersion": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "$ref": "#/$defs/position" },
        "parameters": { "type": "object" },
        "credentials": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "settings": { "type": "object" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "ai_agent",
            "ai_chain",
            "ai_document",
            "ai_embedding",
            "ai_languageModel",
            "ai_memory",
            "ai_outputParser",
            "ai_retriever",
            "ai_reranker",
            "ai_textSplitter",
            "ai_tool",
            "ai_vectorStore"
          ]
        },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" }
      }
    }
  }
}
