{
  "type": "pack.telegram",
  "version": 1,
  "displayName": "Telegram",
  "description": "Send messages, media and chat actions through a Telegram bot.",
  "category": "Messaging",
  "icon": "builtin:send",
  "iconColor": "#2aabee",
  "subtitle": "{{ $parameter.operation }}: {{ $parameter.resource }}",
  "documentationUrl": "https://core.telegram.org/bots/api",
  "credentialType": "telegramApi",
  "requestDefaults": {
    "baseURL": "{{ $credentials.baseUrl }}"
  },
  "parameters": [
    {
      "key": "chatId",
      "label": "Chat ID",
      "kind": "string",
      "resources": [
        "chat",
        "message"
      ],
      "operations": [
        "administrators",
        "deleteMessage",
        "editMessageText",
        "get",
        "leave",
        "member",
        "pinChatMessage",
        "sendAnimation",
        "sendAudio",
        "sendChatAction",
        "sendDocument",
        "sendLocation",
        "sendMediaGroup",
        "sendMessage",
        "sendPhoto",
        "sendSticker",
        "sendVideo",
        "setDescription",
        "setTitle",
        "unpinChatMessage"
      ],
      "description": "A numeric chat id or an @channelusername. Sent as written: coercing it to a number breaks every channel username, and Telegram accepts both forms.",
      "required": true
    },
    {
      "key": "text",
      "label": "Text",
      "kind": "string",
      "resources": [
        "callback",
        "message"
      ],
      "operations": [
        "answerQuery",
        "editMessageText",
        "sendMessage"
      ],
      "description": "The message text.",
      "typeOptions": {
        "rows": 4
      }
    },
    {
      "key": "file",
      "label": "File",
      "kind": "string",
      "resources": [
        "message"
      ],
      "operations": [
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "A file_id Telegram already holds, or a public URL. Leave empty and name a binary property to upload the item's own attachment instead."
    },
    {
      "key": "binaryPropertyName",
      "label": "Binary Property",
      "kind": "string",
      "resources": [
        "message"
      ],
      "operations": [
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendMediaGroup",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "The item's binary property to upload. Leave empty to send the File field instead."
    },
    {
      "key": "caption",
      "label": "Caption",
      "kind": "string",
      "resources": [
        "message"
      ],
      "operations": [
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "Text shown under the attachment."
    },
    {
      "key": "parseMode",
      "label": "Parse Mode",
      "kind": "options",
      "resources": [
        "message"
      ],
      "operations": [
        "editMessageText",
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendMessage",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "How Telegram reads the markup in the text.",
      "default": "",
      "options": [
        {
          "label": "None",
          "value": ""
        },
        {
          "label": "Markdown",
          "value": "Markdown"
        },
        {
          "label": "MarkdownV2",
          "value": "MarkdownV2"
        },
        {
          "label": "HTML",
          "value": "HTML"
        }
      ]
    },
    {
      "key": "replyMarkup",
      "label": "Reply Markup",
      "kind": "json",
      "resources": [
        "message"
      ],
      "operations": [
        "editMessageText",
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendMessage",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "An inline keyboard or reply keyboard, as the Bot API's JSON."
    },
    {
      "key": "replyToMessageId",
      "label": "Reply To Message ID",
      "kind": "number",
      "resources": [
        "message"
      ],
      "operations": [
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendLocation",
        "sendMediaGroup",
        "sendMessage",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "Answer a specific message."
    },
    {
      "key": "disableNotification",
      "label": "Disable Notification",
      "kind": "boolean",
      "resources": [
        "message"
      ],
      "operations": [
        "pinChatMessage",
        "sendAnimation",
        "sendAudio",
        "sendDocument",
        "sendLocation",
        "sendMediaGroup",
        "sendMessage",
        "sendPhoto",
        "sendSticker",
        "sendVideo"
      ],
      "description": "Deliver silently."
    },
    {
      "key": "media",
      "label": "Media",
      "kind": "json",
      "resources": [
        "message"
      ],
      "operations": [
        "sendMediaGroup"
      ],
      "description": "The Bot API's media array for an album."
    },
    {
      "key": "latitude",
      "label": "Latitude",
      "kind": "number",
      "resources": [
        "message"
      ],
      "operations": [
        "sendLocation"
      ],
      "description": "Latitude of the point."
    },
    {
      "key": "longitude",
      "label": "Longitude",
      "kind": "number",
      "resources": [
        "message"
      ],
      "operations": [
        "sendLocation"
      ],
      "description": "Longitude of the point."
    },
    {
      "key": "action",
      "label": "Action",
      "kind": "options",
      "resources": [
        "message"
      ],
      "operations": [
        "sendChatAction"
      ],
      "description": "The status to show.",
      "default": "typing",
      "options": [
        {
          "label": "Typing",
          "value": "typing"
        },
        {
          "label": "Upload Photo",
          "value": "upload_photo"
        },
        {
          "label": "Record Video",
          "value": "record_video"
        },
        {
          "label": "Upload Video",
          "value": "upload_video"
        },
        {
          "label": "Record Voice",
          "value": "record_voice"
        },
        {
          "label": "Upload Voice",
          "value": "upload_voice"
        },
        {
          "label": "Upload Document",
          "value": "upload_document"
        },
        {
          "label": "Choose Sticker",
          "value": "choose_sticker"
        },
        {
          "label": "Find Location",
          "value": "find_location"
        },
        {
          "label": "Record Video Note",
          "value": "record_video_note"
        },
        {
          "label": "Upload Video Note",
          "value": "upload_video_note"
        }
      ]
    },
    {
      "key": "messageId",
      "label": "Message ID",
      "kind": "number",
      "resources": [
        "message"
      ],
      "operations": [
        "deleteMessage",
        "editMessageText",
        "pinChatMessage",
        "unpinChatMessage"
      ],
      "description": "Which message to act on."
    },
    {
      "key": "inlineMessageId",
      "label": "Inline Message ID",
      "kind": "string",
      "resources": [
        "message"
      ],
      "operations": [
        "editMessageText"
      ],
      "description": "The inline message to edit, instead of a chat message."
    },
    {
      "key": "userId",
      "label": "User ID",
      "kind": "number",
      "resources": [
        "chat"
      ],
      "operations": [
        "member"
      ],
      "description": "Which user to read."
    },
    {
      "key": "title",
      "label": "Title",
      "kind": "string",
      "resources": [
        "chat"
      ],
      "operations": [
        "setTitle"
      ],
      "description": "The chat's new title."
    },
    {
      "key": "description",
      "label": "Description",
      "kind": "string",
      "resources": [
        "chat"
      ],
      "operations": [
        "setDescription"
      ],
      "description": "The chat's new description."
    },
    {
      "key": "queryId",
      "label": "Query ID",
      "kind": "string",
      "resources": [
        "callback"
      ],
      "operations": [
        "answerInlineQuery",
        "answerQuery"
      ],
      "description": "The callback or inline query to answer."
    },
    {
      "key": "results",
      "label": "Results",
      "kind": "json",
      "resources": [
        "callback"
      ],
      "operations": [
        "answerInlineQuery"
      ],
      "description": "The inline query results, as the Bot API's JSON array."
    },
    {
      "key": "fileId",
      "label": "File ID",
      "kind": "string",
      "resources": [
        "file"
      ],
      "operations": [
        "get"
      ],
      "description": "The file to resolve and download."
    }
  ],
  "resources": [
    {
      "name": "message",
      "description": "Message",
      "operations": [
        {
          "name": "sendMessage",
          "description": "Send a text message to a chat.",
          "method": "POST",
          "url": "/bot{credential.accessToken}/sendMessage",
          "sends": [
            {
              "from": "chatId",
              "type": "body",
              "property": "chat_id"
            },
            {
              "from": "text",
              "type": "body",
              "property": "text"
            },
            {
              "from": "replyMarkup",
              "type": "body",
              "property": "reply_markup"
            },
            {
              "from": "parseMode",
              "type": "body",
              "property": "parse_mode"
            },
            {
              "from": "replyToMessageId",
              "type": "body",
              "property": "reply_to_message_id"
            },
            {
              "from": "disableNotification",
              "type": "body",
              "property": "disable_notification"
            }
          ]
        },
        {
          "name": "sendPhoto",
          "description": "Send a photo. Either upload the item's attachment or give a file_id or URL.",
